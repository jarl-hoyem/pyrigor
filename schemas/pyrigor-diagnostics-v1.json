{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jarl-hoyem/pyrigor/blob/main/schemas/pyrigor-diagnostics-v1.json",
  "title": "pyrigor diagnostics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnostics", "errors", "summary"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "location", "code", "name", "message", "context", "severity", "fixability"],
      "properties": {
        "file": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "$ref": "#/$defs/position"
            },
            "end": {
              "$ref": "#/$defs/position"
            }
          }
        },
        "code": {
          "type": "string",
          "pattern": "^PYR[0-9]+$"
        },
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "enum": ["Function", "Variable", "Call"]
            },
            "name": {
              "type": "string"
            }
          }
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "fixability": {
          "enum": ["safe_fix", "suggestion", "guidance"]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "kind", "message"],
      "properties": {
        "file": {
          "type": "string"
        },
        "kind": {
          "enum": ["read_error", "parse_error"]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_checked", "diagnostics", "suppressed", "suppressed_by_rule"],
      "properties": {
        "files_checked": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed_by_rule": {
          "type": "object",
          "patternProperties": {
            "^PYR[0-9]+$": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
